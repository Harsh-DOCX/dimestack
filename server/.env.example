# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:5000
SITE_URL=https://dimestack.app

# Leave blank to use a local MongoDB if one is running, otherwise an embedded
# database that restores the latest backup in server/backups.
MONGO_URI=

# Required in production. The server refuses to start without this value.
JWT_SECRET=

# Set to true behind HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false
# Use "lax" with same-site custom domains (for example app.example.com and
# api.example.com). Use "none" only if the frontend and API are on different
# sites; some browsers block cross-site cookies in that configuration.
COOKIE_SAME_SITE=lax

# Google OAuth. Callback must be allowed in the Google Cloud console.
# Local default: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# SMTP. When unset, reset and verification messages print in the API console
# and the local UI shows them so you can finish the flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DimeStack <noreply@dimestack.app>
